# Local access by default. For phone/LAN/VPN access, use this server's fixed LAN IPv4.
NAS_BIND_IP=127.0.0.1
NAS_PORT=8080

# Set to the UID/GID owning the host storage directories (`id -u`, `id -g`).
NAS_UID=1000
NAS_GID=1000
NAS_FILES_PATH=./data/files
NAS_APP_PATH=./data/app

# 10 GiB per file; 7 days per session.
NAS_MAX_UPLOAD_BYTES=10737418240
NAS_SESSION_SECONDS=604800
# Enable only when accessing over HTTPS; HTTP + true prevents login persistence.
NAS_SECURE_COOKIE=false
